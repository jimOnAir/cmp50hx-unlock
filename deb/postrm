#!/bin/bash
# postrm — safety net after prerm did the heavy teardown: cleans any
# leftovers (prerm may have been skipped for a half-installed package)
# and removes state on purge.
set -u

readonly state_dir="/var/lib/cmp50hx-unlock"
readonly install_dir="/opt/cmp50hx-unlock"
readonly log_file="/var/log/cmp50hx-unlock-install.log"
krel="$(uname -r)"
readonly krel
readonly module_list="nvidia nvidia-uvm nvidia-modeset nvidia-drm nvidia-peermem"

log() { printf '[%s] %s\n' "$(date -u +%H:%M:%S)" "$*"; }
warn() { log "WARNING: $*"; }
run_cmd() { "$@" || warn "command failed (ignored): $*"; }

case "${1:-remove}" in
    remove|purge)
        ;;
    *)
        exit 0
        ;;
esac

command -v logger >/dev/null 2>&1 && logger -t cmp50hx-unlock "postrm: $*" || true

# --- apt pin file safety net (prerm normally removed it; only a             ---
# --- half-installed package leaves it behind). deb/apt-pins.sh documents.   ---
if [[ -e /etc/apt/preferences.d/cmp50hx-unlock ]]; then
    rm -f /etc/apt/preferences.d/cmp50hx-unlock
    log "removed leftover apt pin file (prerm never ran)"
fi

# --- leftover NVIDIA userland (only if prerm never ran) ---------------------
if [[ -x /usr/bin/nvidia-uninstall ]]; then
    log "uninstalling leftover NVIDIA userland via /usr/bin/nvidia-uninstall"
    run_cmd sh /usr/bin/nvidia-uninstall --silent
fi

# --- leftover DKMS state (only if the tree was gone before prerm ran) -------
# postrm runs after dpkg deleted /opt, so the build stamp is no longer
# visible here: the driver version comes from the DKMS state directory.
if [[ -d /var/lib/dkms/cmp50hx ]]; then
    log "sweeping leftover DKMS build state for cmp50hx"
    for ver_dir in /var/lib/dkms/cmp50hx/*/; do
        [[ -d "${ver_dir}" ]] || continue
        dkms_ver="${ver_dir#/var/lib/dkms/cmp50hx/}"
        dkms_ver="${dkms_ver%/}"
        if command -v dkms >/dev/null 2>&1; then
            run_cmd dkms remove -m cmp50hx -v "${dkms_ver}" --all
        fi
        for kernel_dir in "${ver_dir}"*/; do
            kernel="$(basename "${kernel_dir}")"
            [[ "${kernel}" =~ ^[0-9] ]] || continue
            for mod in ${module_list}; do
                rm -f "/lib/modules/${kernel}/updates/dkms/${mod}.ko" \
                      "/lib/modules/${kernel}/updates/dkms/${mod}.ko.xz" \
                      "/lib/modules/${kernel}/updates/dkms/${mod}.ko.zst"
            done
            command -v depmod >/dev/null 2>&1 && run_cmd depmod -a "${kernel}"
        done
    done
    rm -rf /var/lib/dkms/cmp50hx
fi

# --- gpu-unlock-claim purge (map 90hx-gen2-610 ticket 06) --------------------
if [[ -d /var/lib/dkms/gpu-unlock-claim ]]; then
    log "removing gpu-unlock-claim from DKMS"
    for ver_dir in /var/lib/dkms/gpu-unlock-claim/*/; do
        dkms_ver="${ver_dir#/var/lib/dkms/gpu-unlock-claim/}"
        dkms_ver="${dkms_ver%/}"
        if command -v dkms >/dev/null 2>&1; then
            run_cmd dkms remove -m gpu-unlock-claim -v "${dkms_ver}" --all || true
        fi
        for kernel in /lib/modules/*/; do
            kernel="${kernel#/lib/modules/}"; kernel="${kernel%/}"
            rm -f "/lib/modules/${kernel}/updates/dkms/gpu_unlock.ko" \
                  "/lib/modules/${kernel}/updates/dkms/gpu_unlock.ko.xz" \
                  "/lib/modules/${kernel}/updates/dkms/gpu_unlock.ko.zst" 2>/dev/null || true
        done
    done
    command -v depmod >/dev/null 2>&1 && run_cmd depmod -a || true
    rm -rf /var/lib/dkms/gpu-unlock-claim
fi
# claim firmware: /lib/firmware/gpu-unlock is owned by this package (the
# ko's GU_FW_* macros resolve there); purge removes the whole tree.
rm -rf /lib/firmware/gpu-unlock

# --- fallback firmware copies tracked by postinst ----------------------------
# The .run uninstaller only removes what IT installed; when postinst had to
# copy GSP firmware by hand it recorded a manifest in ${state_dir} (relative
# to /lib/firmware). Clean those here, before the purge branch deletes the
# state dir (gap 6).
if [[ -f "${state_dir}/firmware-copies.txt" ]]; then
    log "removing the fallback firmware copies tracked in firmware-copies.txt"
    while IFS= read -r rel; do
        case "${rel}" in
            ''|'#'*) continue ;;
            nvidia/*) rm -f "/lib/firmware/${rel}" ;;
            *) warn "ignoring unsafe firmware manifest path: ${rel}" ;;
        esac
    done < "${state_dir}/firmware-copies.txt"
    rm -f "${state_dir}/firmware-copies.txt"
fi

# --- postinst-created leftovers outside the dpkg manifest -------------------
# ${install_dir}/logs is created at configure time and is not a package
# file; without this it survives removal (gap 5). rmdir succeeds only when
# dpkg took everything else, so foreign files are never deleted here.
if [[ -d "${install_dir}" ]]; then
    rm -rf "${install_dir}/logs"
    rmdir "${install_dir}" 2>/dev/null \
        || warn "${install_dir} not empty after file removal; kept for inspection"
fi

# --- initramfs without the patched modules ----------------------------------
# Rebuild EVERY kernel that had our modules (prerm recorded the list while
# the .ko files still existed), not just the running one — otherwise a stale
# patched module stays baked into another kernel's initramfs (gap 3).
if command -v update-initramfs >/dev/null 2>&1; then
    declare -A initrd_kernels=()
    if [[ -r /run/cmp50hx-unlock.initrd-kernels ]]; then
        while IFS= read -r k; do
            [[ -n "${k}" ]] && initrd_kernels["${k}"]=1
        done < /run/cmp50hx-unlock.initrd-kernels
    fi
    initrd_kernels["${krel}"]=1
    for k in "${!initrd_kernels[@]}"; do
        if [[ -e "/boot/initrd.img-${k}" ]] || [[ -e "/boot/initramfs.img-${k}" ]]; then
            log "rebuilding the initramfs for ${k} without the patched modules"
            run_cmd update-initramfs -u -k "${k}"
        fi
    done
    rm -f /run/cmp50hx-unlock.initrd-kernels
fi

if [[ "${1:-remove}" == "purge" ]]; then
    rm -rf "${state_dir}"
    rm -f "${log_file}"
    # install-initramfs.sh keeps up to 3 pre-rebuild initrd backups for its
    # --rollback option; a purge means this host will never boot into that
    # stack again, so the backups go with it (gap 8)
    shopt -s nullglob
    rm -f /boot/initrd.img-*.cmp50-bak-*
    shopt -u nullglob
    log "purged ${state_dir}, ${log_file} and the /boot initrd rollback backups"
fi

# Note: /etc/modprobe.d/cmp-unlock.conf and /etc/modprobe.d/cmp50hx-unlock.conf
# are dpkg conffiles: kept on "remove", deleted on "purge" (standard policy).

log "cmp50hx-unlock removal complete; reboot to finish reverting to a driverless state"
exit 0
