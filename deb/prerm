#!/bin/bash
# prerm — do the heavy teardown while the package's files still exist:
# dpkg deletes /usr/src and /opt before postrm runs, and both the DKMS
# tree and the staged .run are needed for a clean removal.
set -u

readonly install_dir="/opt/cmp50hx-unlock"
readonly state_dir="/var/lib/cmp50hx-unlock"

log() { printf '[%s] %s\n' "$(date -u +%H:%M:%S)" "$*"; }
warn() { log "WARNING: $*"; }
run_cmd() { "$@" || warn "command failed (ignored): $*"; }

# The build stamps the driver version into ${install_dir}/VERSION (dpkg
# keeps package files until after prerm). If the stamp is gone, fall back
# to globbing the staged .run files — never hardcode the version here.
driver_version="$(cut -d- -f1 < "${install_dir}/VERSION" 2>/dev/null || true)"
if [[ -n "${driver_version}" ]]; then
    run_candidates=(
        "${install_dir}/cache/NVIDIA-Linux-x86_64-${driver_version}.run"
        "${state_dir}/NVIDIA-Linux-x86_64-${driver_version}.run"
    )
else
    warn "${install_dir}/VERSION missing; globbing for staged NVIDIA .run files"
    run_candidates=(
        "${install_dir}"/cache/NVIDIA-Linux-x86_64-*.run
        "${state_dir}"/NVIDIA-Linux-x86_64-*.run
    )
fi

command -v logger >/dev/null 2>&1 && logger -t cmp50hx-unlock "prerm: $*" || true

case "${1:-remove}" in
    remove|deconfigure|failed-upgrade)
        ;;
    upgrade)
        # Downgrade (and ordinary upgrade) arrives here as `prerm upgrade
        # <incoming-version>` on the OUTGOING package — this is the last
        # script of ours dpkg runs: the postrm that follows at the end of
        # the transaction executes from /var/lib/dpkg/info, which by then
        # holds the INCOMING version's scripts (dpkg --debug=777 trace,
        # 2026-11-01). A claim-less revision's postrm cannot sweep OUR
        # gpu-unlock-claim registration, so downgrading away un-swept
        # leaves /var/lib/dkms/gpu-unlock-claim orphaned and every later
        # dkms run dies ("broken", Manual intervention required).
        # Self-protect here when the incoming version predates the claim
        # module (introduced 20261101.17). Upgrades to claim-aware
        # revisions: no-op; their postinst rebuilds the registration.
        incoming="${2:-}"
        if [[ -n "${incoming}" ]] \
                && dpkg --compare-versions "${incoming}" lt "610.43.03-20261101.17" 2>/dev/null; then
            log "incoming ${incoming} predates gpu-unlock-claim: sweeping claim DKMS state"
            # Do NOT `systemctl disable` here: plain systemctl disable marks
            # the unit user-disabled, and deb-systemd-helper (which the
            # postinst uses) then refuses to re-enable it on re-upgrade —
            # silent Gen2 loss after upgrade-back (`.21` self-test lesson).
            # dpkg deletes the unit file moments later; a dangling wants
            # symlink is proven harmless (rev15 rehearsal boots).
            if command -v dkms >/dev/null 2>&1; then
                for ver_dir in /var/lib/dkms/gpu-unlock-claim/*/; do
                    [[ -d "${ver_dir}" ]] || continue
                    dkms_ver="${ver_dir#/var/lib/dkms/gpu-unlock-claim/}"
                    dkms_ver="${dkms_ver%/}"
                    run_cmd dkms remove -m gpu-unlock-claim -v "${dkms_ver}" --all
                done
            fi
            for kernel_dir in /lib/modules/*/; do
                k="${kernel_dir#/lib/modules/}"; k="${k%/}"
                rm -f "/lib/modules/${k}/updates/dkms/gpu_unlock.ko" \
                      "/lib/modules/${k}/updates/dkms/gpu_unlock.ko.xz" \
                      "/lib/modules/${k}/updates/dkms/gpu_unlock.ko.zst" 2>/dev/null || true
            done
            command -v depmod >/dev/null 2>&1 && run_cmd depmod -a || true
            rm -rf /var/lib/dkms/gpu-unlock-claim
            rm -rf /lib/firmware/gpu-unlock
        fi
        exit 0
        ;;
    *)
        exit 0
        ;;
esac

# --- release the apt pin file this package set --------------------------------
# Inline by design: removal must not depend on /opt helper files that a
# half-finished upgrade may have replaced. deb/apt-pins.sh documents the
# contract; postrm repeats this removal as the safety net.
if [[ -e /etc/apt/preferences.d/cmp50hx-unlock ]]; then
    rm -f /etc/apt/preferences.d/cmp50hx-unlock
    log "removed the apt pin file /etc/apt/preferences.d/cmp50hx-unlock"
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl stop cmp-idle-governor.service 2>/dev/null || true
fi

# --- NVIDIA userland uninstall (while the .run is still on disk) ------------
for candidate in "${run_candidates[@]}"; do
    [[ -f "${candidate}" ]] || continue
    log "uninstalling the NVIDIA userland via ${candidate}"
    run_cmd sh "${candidate}" --uninstall --silent
    break
done

# --- remember which kernels booted with our modules -------------------------
# postrm must rebuild EVERY such kernel's initramfs after the .ko files are
# gone — rebuilding only the running kernel leaves a stale patched module
# baked into another kernel's image. prerm runs while the files still exist;
# the list goes to /run, which survives dpkg's file removal between prerm
# and postrm (deb-purge-lifecycle gap 3).
initrd_list="/run/cmp50hx-unlock.initrd-kernels"
: > "${initrd_list}" 2>/dev/null || true
shopt -s nullglob
for ko in /lib/modules/*/updates/dkms/nvidia.ko /lib/modules/*/updates/dkms/nvidia.ko.*; do
    printf '%s\n' "${ko#/lib/modules/}" | cut -d/ -f1 >> "${initrd_list}" 2>/dev/null || true
done
shopt -u nullglob
[[ -s "${initrd_list}" ]] && sort -u "${initrd_list}" -o "${initrd_list}" 2>/dev/null || true

# --- DKMS tree and modules for every kernel (tree still present) -----------
if command -v dkms >/dev/null 2>&1; then
    for ver_dir in /usr/src/cmp50hx-*/; do
        [[ -d "${ver_dir}" ]] || continue
        dkms_ver="${ver_dir#/usr/src/cmp50hx-}"
        dkms_ver="${dkms_ver%/}"
        log "removing the patched module tree cmp50hx/${dkms_ver} from DKMS"
        run_cmd dkms remove -m cmp50hx -v "${dkms_ver}" --all
    done
fi

# --- services ----------------------------------------------------------------
if command -v systemctl >/dev/null 2>&1; then
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper disable cmp50hx-boot.service cmp-idle-governor.service cmp50hx-gen2.service cmp-governor-check.service cmp-governor-check.timer cmp90hx-claim.service >/dev/null 2>&1 || true
        deb-systemd-helper purge cmp50hx-boot.service cmp-idle-governor.service cmp50hx-gen2.service cmp-governor-check.service cmp-governor-check.timer cmp90hx-claim.service >/dev/null 2>&1 || true
        # plain systemctl too: cmp90hx-claim was enabled via the helper at
        # install; drop any live symlink a helper-only pass might miss
        systemctl disable cmp90hx-claim.service >/dev/null 2>&1 || true
        rm -f /etc/systemd/system/*.wants/cmp90hx-claim.service 2>/dev/null || true
    fi
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
[[ -L /usr/local/bin/rm-issue-rate ]] && rm -f /usr/local/bin/rm-issue-rate

# --- UEFI boot entry + ESP files ---------------------------------------------
# CMP_ESP_SKIP=1 is the same host-side convention deb/postinst documents for
# its ESP deploy: a curated multi-entry boot chain must also survive the
# teardown. Without the flag, removal reverts the deploy (gap 1).
if [[ "${CMP_ESP_SKIP:-0}" == "1" ]]; then
    log "CMP_ESP_SKIP=1: leaving the UEFI boot entry and ESP files untouched (curated boot chain; redeploy with ${install_dir}/efi/install-linux.sh when intended)"
elif [[ -d /sys/firmware/efi && -f "${install_dir}/efi/install-linux.sh" ]]; then
    log "removing the 50HX Unlock boot entry"
    run_cmd bash "${install_dir}/efi/install-linux.sh" --remove
fi

exit 0
