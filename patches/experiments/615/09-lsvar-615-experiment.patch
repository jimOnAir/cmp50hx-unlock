+/*
+ * ticket-11 (615 LS-metadata experiment, research-11-booter-analysis.md):
+ * per-GPU override of the LS ucode version/id the crafted signature frames
+ * declare, plus an optional stock-looking header declaration for the GA102
+ * V67 frame (the TU102 frame always declares one). Keys come from
+ * NVreg_RegistryDwordsPerDevice ("pci=<bdf>,RmCmpLsVersion=0x441,..."),
+ * resolved per-GPU by osReadRegistryDword; absent = shipped defaults
+ * (TU102: 0x344/1; GA102: header/slots untouched). One log line per GPU
+ * records the effective values for the boot verdict: CMP50_LSV / CMP90_LSV.
+ */
+static void
+_kgspCmpLsVarOverride
+(
+    OBJGPU  *pGpu,
+    const char *tag,
+    NvU32  *pLsVersion,
+    NvU32  *pLsId,
+    NvBool *pDeclare
+)
+{
+    NvU32 v = 0;
+
+    if (osReadRegistryDword(pGpu, "RmCmpLsVersion", &v) == NV_OK && (v != 0))
+    {
+        *pLsVersion = v;
+    }
+
+    v = 0;
+    if (osReadRegistryDword(pGpu, "RmCmpLsId", &v) == NV_OK && (v != 0))
+    {
+        *pLsId = v;
+    }
+
+    v = 0;
+    if ((pDeclare != NULL) &&
+        (osReadRegistryDword(pGpu, "RmCmpLsDeclare", &v) == NV_OK) && (v != 0))
+    {
+        *pDeclare = NV_TRUE;
+    }
+
+    NV_PRINTF(LEVEL_ERROR,
+              "%s: effective ls_version=0x%x ls_id=0x%x declare=%d\n",
+              tag, *pLsVersion, *pLsId,
+              (pDeclare != NULL) ? (*pDeclare ? 1 : 0) : -1);
+}
