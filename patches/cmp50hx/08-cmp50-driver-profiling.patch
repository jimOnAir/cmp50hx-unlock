diff --git a/src/nvidia/src/kernel/gpu/gpu_gspclient.c b/src/nvidia/src/kernel/gpu/gpu_gspclient.c
--- a/src/nvidia/src/kernel/gpu/gpu_gspclient.c
+++ b/src/nvidia/src/kernel/gpu/gpu_gspclient.c
@@ -340,6 +340,20 @@
     GspStaticConfigInfo *pGSCI = GPU_GET_GSP_STATIC_INFO(pGpu);
     NV_ASSERT_OR_RETURN(pGSCI != NULL, NV_FALSE);
 
+    /*
+     * CMP profiling unlock (610 lineage: 08-cmp50-driver-profiling cleared
+     * pChipInfo->isCmpSku in _gpuInitChipInfo). 615 moved the flag to the
+     * decoded GSP static config behind this accessor; clear it for the exact
+     * CMP 50HX identity so NV2080_CTRL_GPU_INFO_INDEX_CMP_SKU reports NO and
+     * the userland perf-counter path stays unlocked.
+     */
+    if ((pGpu->idInfo.PCIDeviceID == 0x1E0910DEU) &&
+        ((pGpu->idInfo.PCISubDeviceID == 0x155410DEU) ||
+         (pGpu->idInfo.PCISubDeviceID == 0x371F1462U)))
+    {
+        return NV_FALSE;
+    }
+
     return pGSCI->bIsCmpSku;
 }
 
