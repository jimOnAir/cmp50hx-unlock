+/*
+ * rc3c: quiet per-query reader of the EFI-only switch (RmCmpSkipStockflow;
+ * see kernel_gsp.c for the mode documentation). With the switch set, ALL
+ * CMP50-instrumented GSP verification paths must behave exactly like stock:
+ * 615's stock Booter handoff places WPR2 lo at 0x277e000 (measured), not
+ * the 610-era constant the V274/V551 expectations compare against.
+ */
+static NvBool
+s_cmp50EfiOnlyQ
+(
+    OBJGPU *pGpu
+)
+{
+    NvU32 v = 0;
+
+    return ((osReadRegistryDword(pGpu, "RmCmpSkipStockflow", &v) == NV_OK) && (v != 0));
+}
