+/*
+ * 615-gen2-h2 ticket-03: true when this device carries the frame-variant
+ * experiment key (RmCmpFrameVariant, see kernel_gsp.c builder).
+ */
+static NvBool
+s_cmp50FrameVariantActiveQ
+(
+    OBJGPU *pGpu
+)
+{
+    NvU32 v = 0;
+
+    return ((osReadRegistryDword(pGpu, "RmCmpFrameVariant", &v) == NV_OK) && (v != 0));
+}
+
+/*
+ * 615 stock FWSEC keeps the same WPR2 reservation (capture is live and
+ * valid), but the stock BOOTER hands off WPR2 lo 0x80000 lower than the
+ * capture (measured 0x27fe000 -> 0x277e000; 615-gen2-h2 ticket-01 section
+ * 7).  The stock-equality guards below predate that measurement; tolerate
+ * the down-extension ONLY while the frame-variant experiment is armed on
+ * this device, and log which value matched so the boot verdict stays
+ * attributable.  Production paths (no variant key) are untouched.
+ */
+static NvBool
+s_cmp50WprLoTolerated
+(
+    OBJGPU *pGpu,
+    NvU32  idx,
+    NvU32  lo
+)
+{
+    NvU32 stock = g_cmp50StockWprLo[idx];
+
+    if (lo == stock)
+    {
+        return NV_TRUE;
+    }
+
+    if (s_cmp50FrameVariantActiveQ(pGpu) && (stock != 0U) &&
+        (lo == (stock - 0x00080000U)))
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "CMP50_FRAMEVAR: 615 WPR2-lo down-extension tolerated "
+                  "lo=0x%08x stock=0x%08x\n", lo, stock);
+        return NV_TRUE;
+    }
+
+    return NV_FALSE;
+}
