+/*
+ * 615-gen2-h2 ticket-03: per-device frame-variant selector
+ * (NVreg_RegistryDwordsPerDevice key RmCmpFrameVariant; absent/0 keeps the
+ * stock 610-era frame = V3 control).  Applied AFTER the normal signature
+ * table build so a variant always wins.  Values per
+ * .scratch/615-gen2-h2/research/manifest-tlv-dmem.md section 6:
+ *   V1 (1): faithful stock-615 static descriptor (gate-reads-statics test)
+ *   V2 (2): V1 + verifier spilled task state rebuilt with 615 values
+ *   V5:     V1b, hdr length field = 0xFA00 instead of 0x8C8 (one-dword A/B)
+ * Any tracepc moving off 0x1b38 means the new 615 data gate was passed.
+ */
+static void
+_kgspCmp50ApplyFrameVariant(OBJGPU *pGpu, NvU8 *pSignatureVa)
+{
+    NvU32 v = 0;
+
+    if ((osReadRegistryDword(pGpu, "RmCmpFrameVariant", &v) != NV_OK) || (v == 0U))
+    {
+        return;
+    }
+
+    if ((v == 1U) || (v == 2U) || (v == 5U))
+    {
+        _kgspCmp50PutU32(pSignatureVa, 0x0004, (v == 5U) ? 0x000FA00U : 0x000008C8U);
+        _kgspCmp50PutU32(pSignatureVa, 0x0008, 0x0000000CU);
+        _kgspCmp50PutU32(pSignatureVa, 0x000C, 0x00000101U);
+        _kgspCmp50PutU32(pSignatureVa, 0x0010, 0x00000200U);
+        _kgspCmp50PutU32(pSignatureVa, 0x0814, 0x00010001U);
+        _kgspCmp50PutU32(pSignatureVa, 0x0818, 0x00010001U);
+        _kgspCmp50PutU32(pSignatureVa, 0x081C, 0x00000001U);
+        _kgspCmp50PutU32(pSignatureVa, 0x087C, 0x00000001U);
+        _kgspCmp50PutU32(pSignatureVa, 0x0880, 0x00000441U);
+    }
+
+    if (v == 2U)
+    {
+        /* spilled verifier locals: task_init/task_rm stack_top + entry_pc */
+        _kgspCmp50PutU32(pSignatureVa, 0xF914, 0x05646000U);
+        _kgspCmp50PutU32(pSignatureVa, 0xF918, 0x05656000U);
+        _kgspCmp50PutU32(pSignatureVa, 0xF91C, 0x04018DC0U);
+        _kgspCmp50PutU32(pSignatureVa, 0xF920, 0x05503850U);
+    }
+
+    NV_PRINTF(LEVEL_ERROR,
+              "CMP50_FRAMEVAR: RmCmpFrameVariant=%u applied\n", v);
+}
