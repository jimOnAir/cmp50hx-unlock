# driver-pin.env — single source of truth for the pinned NVIDIA driver.
#
# Sourced by: build.sh, tools/build-deb.sh, tools/smoke-test-deb.sh,
# install.sh (when run from a repo checkout). install.sh keeps an inline
# fallback for the `curl | bash` bootstrap path; build.sh asserts the
# fallback matches this pin whenever install.sh sits next to it.
#
# Every value moves together on a driver bump: version, source tarball hash
# (GitHub tag archive), official .run hash. The version string is NOT baked
# into any other script — if you find it elsewhere in code, that is drift.
# Historical prose (docs/, READMEs, findings.md, efi-unlock formula notes,
# decompil/ filenames) legitimately carries old version names: provenance.
DRIVER_VERSION=615.78.08
SOURCE_SHA256=eac0ecd52facab28ad2963cf7e03ae8d2289d596ad590c703b5f72d65899e2bf
NVIDIA_RUN_SHA256=3e3f6dddc2ee767a08185300af7be3cb286ece76698d2dde3524599782d07ffe
